{
	"name": "pty-remote-repl",
	"init": "true",
	"prompt": "登录主机 target，在交互式 python3 里计算 2**100，把结果告诉我。",
	"finalAssertion": "true",
	"calls": {
		"expect": [
			{
				"tool": [
					"bash",
					"eval"
				],
				"isError": false,
				"inputPattern": "(?=.*\"pty\":true)(?=.*\"command\":)|tool\\.bash\\([^)]*pty[\"'\\\\]*\\s*:\\s*[tT]rue"
			},
			{
				"tool": [
					"write_stdin",
					"eval"
				],
				"isError": false,
				"inputPattern": "job_id|chars|tool\\.write_stdin\\("
			}
		],
		"forbid": [
			{
				"tool": "bash",
				"isError": false,
				"inputPattern": "^(?!.*\"pty\":true).*(?:\"command\":\"|command\\\\\":\\\\\"|[;&|(`]\\s*|\\\\n\\s*|\\[\\\\\"|\\(\\\\\")\\s*(?:(?:timeout\\s+\\S+|sudo(?:\\s+-\\S+)*|env(?:\\s+\\w+=\\S*)*|nohup|exec|command)\\s+)?(?:ssh(?![\\w.-])(?!\\s+-[GVO]\\b)|python3(?![\\w.-]))"
			},
			{
				"tool": "eval",
				"isError": false,
				"inputPattern": "^(?!.*(tool\\.bash\\([^)]*pty[\"'\\\\]*\\s*:\\s*[tT]rue|tool\\.write_stdin\\())(?=.*(?:\"command\":\"|command\\\\\":\\\\\"|[;&|(`]\\s*|\\\\n\\s*|\\[\\\\\"|\\(\\\\\")\\s*(?:(?:timeout\\s+\\S+|sudo(?:\\s+-\\S+)*|env(?:\\s+\\w+=\\S*)*|nohup|exec|command)\\s+)?(?:ssh(?![\\w.-])(?!\\s+-[GVO]\\b)|python3(?![\\w.-])))"
			}
		]
	},
	"replyIncludes": [
		"1267650600228229401496703205376"
	]
}
