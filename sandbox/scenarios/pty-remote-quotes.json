{
	"name": "pty-remote-quotes",
	"init": "true",
	"prompt": "在主机 target 上执行下面这段脚本，把输出原样告诉我：`printf '%s\\n' \"a'b\" 'c\"d' 'x\\ty'; awk -F: '$1==\"root\"{print \"(\" $7 \")\"}' /etc/passwd`",
	"finalAssertion": "true",
	"calls": {
		"expect": [
			{
				"tool": "write",
				"isError": false,
				"inputPattern": "(?=.*\"xd://exec_command\")(?=.*target)",
				"resultIncludes": "exit_code: 0"
			}
		],
		"forbid": [
			{ "tool": "bash", "isError": false, "inputPattern": "\\bssh\\b" },
			{ "tool": "eval", "isError": false, "inputPattern": "\\bssh\\b" },
			{ "tool": "write", "isError": false, "inputPattern": "(?=.*\"xd://bash\")(?=.*\\bssh\\b)" }
		]
	},
	"replyIncludes": ["a'b", "c\"d", "x\\ty", "(/bin/bash)"]
}
